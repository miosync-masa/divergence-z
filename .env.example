# ===========================================
# Divergence-Z — API keys for the CLI
# ===========================================
# リポジトリ直下に .env としてコピーして使う（git には入らない）。
# デスクトップアプリはこのファイルを使わず、アプリの「キー & モデル」画面で入力する。
# Copy to .env at the repo root for the CLI. The desktop app does not read this file.

# OpenAI（persona / episode / cast の抽出・翻訳の既定モデル gpt-5.6-sol）
OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic（Web 検索での生成・ボイスの既定モデル claude-opus-5-5）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 既定モデルの上書き（任意） / Optional default-model overrides
# PERSONA_EXTRACTOR_MODEL=gpt-5.6-sol
# PERSONA_EXTRACTOR_REASONING=max
# PERSONA_GENERATOR_MODEL=claude-opus-5-5
# EPISODE_GENERATOR_MODEL=claude-opus-5-5
# PERSONA_VOICE_MODEL=claude-opus-5-5

# モデル登録表の場所（任意。既定 ~/.divergence_z/models.yaml）
# DZ_MODELS=/path/to/models.yaml
