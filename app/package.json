{
  "name": "divergence-z-app",
  "private": true,
  "version": "0.1.0",
  "description": "Divergence-Z desktop app (BYOK)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env DZ_DEV_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "js-yaml": "^5.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "type": "module"
}
